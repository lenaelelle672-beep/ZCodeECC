{
  "mcp": {
    "servers": {
      "exa-web-search": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "exa-mcp-server"
        ],
        "env": {
          "EXA_API_KEY": "YOUR_EXA_API_KEY_HERE"
        },
        "enabled": false
      }
    }
  }
}
